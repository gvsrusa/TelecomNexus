# TelecomNexus Root Environment Variables
# This file documents project-wide environment variables
# Individual services/apps have their own .env.example files in their directories

# Database Ports (used by Docker Compose)
# See docker/.env for Docker-specific configuration
MONGO_PORT=27017
CASSANDRA_PORT=9042

# Note: Each service and app has its own .env.example file:
# - apps/gateway/.env.example
# - apps/services/customer-service/.env.example
# - apps/services/network-service/.env.example
# - apps/services/billing-service/.env.example
# - apps/shell/.env.example
# - apps/customer-portal/.env.example
# - apps/noc-dashboard/.env.example
# - apps/billing-console/.env.example

# Packages (packages/*) do not require environment variables:
# - packages/config/ - Shared ESLint, Prettier, TypeScript configs
# - packages/graphql-schema/ - GraphQL schema definitions
# - packages/types/ - Shared TypeScript types
# - packages/ui/ - Shared React component library
# - packages/xml-utils/ - XML parsing/generation utilities
# These are library packages consumed by apps/services, not standalone services.
