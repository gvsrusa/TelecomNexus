{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "incremental": true,
    "noEmit": true
  },
  "include": ["src/**/*", "next.config.*"],
  "exclude": ["node_modules"]
}
