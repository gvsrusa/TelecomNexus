{
  "name": "telecom-nexus",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Telecom Customer & Network Operations Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "seed": "turbo run seed",
    "codegen": "turbo run codegen",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "turbo": "^2.3.3"
  },
  "workspaces": [
    "apps/*",
    "apps/services/*",
    "packages/*",
    "scripts"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write --ignore-unknown"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2"
}
